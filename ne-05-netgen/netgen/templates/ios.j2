! {{ dev.name }} ({{ site.name }}) - generated by netgen, do not edit by hand
hostname {{ dev.name }}
!
{% for v in site.vlans %}
vlan {{ v.id }}
 name {{ v.name }}
!
{% endfor %}
{% if dev.loopback %}
interface Loopback0
 ip address {{ dev.loopback | host }} {{ dev.loopback | netmask }}
!
{% endif %}
{% for i in dev.interfaces %}
{% if i.mode == "svi" %}
interface Vlan{{ i.vlan }}
{% else %}
interface {{ i.name }}
{% endif %}
{% if i.description %}
 description {{ i.description }}
{% endif %}
{% if i.mode == "access" %}
 switchport mode access
 switchport access vlan {{ i.vlan }}
{% elif i.mode == "trunk" %}
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan {{ i.trunk_vlans | join(",") }}
{% elif i.ip %}
{% if i.mode == "routed" %}
 no switchport
{% endif %}
 ip address {{ i.ip | host }} {{ i.ip | netmask }}
{% endif %}
{% if i.shutdown %}
 shutdown
{% else %}
 no shutdown
{% endif %}
!
{% endfor %}
{% set ospf_ifs = dev.interfaces | selectattr("ospf_area", "ne", none) | list %}
{% if ospf_ifs %}
router ospf 1
 router-id {{ dev.loopback | host }}
 passive-interface default
{% for i in ospf_ifs if i.mode == "routed" %}
 no passive-interface {{ i.name }}
{% endfor %}
{% if dev.loopback %}
 network {{ dev.loopback | host }} 0.0.0.0 area 0
{% endif %}
{% for i in ospf_ifs %}
 network {{ i.ip | network }} {{ i.ip | wildcard }} area {{ i.ospf_area }}
{% endfor %}
!
{% endif %}
end
