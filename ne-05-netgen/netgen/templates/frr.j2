! {{ dev.name }} ({{ site.name }}) - generated by netgen, do not edit by hand
frr defaults traditional
hostname {{ dev.name }}
service integrated-vtysh-config
!
{% set ospf_ifs = dev.interfaces | selectattr("ospf_area", "ne", none) | list %}
{% if dev.loopback %}
interface lo
 ip address {{ dev.loopback }}
{% if ospf_ifs %}
 ip ospf area 0
{% endif %}
exit
!
{% endif %}
{% for i in dev.interfaces %}
interface {{ i.name }}
{% if i.description %}
 description {{ i.description }}
{% endif %}
{% if i.ip %}
 ip address {{ i.ip }}
{% endif %}
{% if i.ospf_area is not none %}
 ip ospf area {{ i.ospf_area }}
{% if i.ospf_cost %}
 ip ospf cost {{ i.ospf_cost }}
{% endif %}
{% if i.mode == "routed" and not i.ospf_passive %}
 ip ospf network point-to-point
{% endif %}
{% if i.ospf_hello %}
 ip ospf hello-interval {{ i.ospf_hello }}
 ip ospf dead-interval {{ i.ospf_dead }}
{% endif %}
{% if i.ospf_passive %}
 ip ospf passive
{% endif %}
{% endif %}
{% if i.shutdown %}
 shutdown
{% endif %}
exit
!
{% endfor %}
{% if ospf_ifs %}
router ospf
 ospf router-id {{ dev.loopback | host }}
{% for i in ospf_ifs if i.mode != "routed" %}
 passive-interface {{ i.name }}
{% endfor %}
exit
!
{% endif %}
end
